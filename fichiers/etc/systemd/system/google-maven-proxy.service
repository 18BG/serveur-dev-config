[Unit]
Description=Proxy local vers dl.google.com (dépôt Maven Google pour Gradle)
Documentation=file:///opt/google-maven-proxy/proxy.py
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 -I /opt/google-maven-proxy/proxy.py
Restart=always
RestartSec=2
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
